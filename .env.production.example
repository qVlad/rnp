# ----------------------------------------------------------------------------
# .env for production deploy on 192.168.31.61 (external 94.198.130.185:4098)
# Copy to `.env` and fill in the <<<...>>> secrets.
# Keep this file ASCII-only to avoid encoding issues across locales/editors.
# ----------------------------------------------------------------------------

# --- Wildberries Seller API ---
# JWT token with scopes: Statistics, Promotion, Analytics, Finance.
# Create: WB Seller cabinet -> Settings -> API access -> generate token.
# Lifetime: 180 days; reissue and update this file when it expires.
WB_TOKEN=<<<paste-WB-token-here>>>

# --- Database (inside docker network -- do NOT change) ---
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/rnp
DATABASE_URL_SYNC=postgresql+psycopg2://app:app@postgres:5432/rnp

# --- Redis (Celery broker + cache, inside docker network) ---
REDIS_URL=redis://redis:6379/0

# --- App ---
APP_NAME=RNP Wildberries
DEBUG=false
TIMEZONE=Europe/Moscow
HISTORY_DAYS_ON_FIRST_RUN=90

# --- WB API rate limits ---
# 1/min for statistics, 3/min for advert (effective WB ceiling).
# When you switch to Personal token you may bump statistics to 5/min.
WB_STATS_RATE_PER_MIN=1
WB_ADVERT_RATE_PER_MIN=3
WB_REQUEST_TIMEOUT=60

# --- Authentication ---
# JWT_SECRET_KEY -- long random string. CHANGE BEFORE DEPLOY.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates all active sessions.
JWT_SECRET_KEY=<<<run python3 -c 'import secrets; print(secrets.token_urlsafe(48))' and paste here>>>

# Fernet key для шифрования WB-токенов в БД. ОБЯЗАТЕЛЬНО для multi-tenant
# production: без ключа токены лежат plaintext (если кто-то получит дамп БД —
# получит все клиентские WB-аккаунты).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: при ротации ключа нужно сначала расшифровать всё старым, потом
# зашифровать новым (нет автоматики). НЕ ТЕРЯТЬ — без ключа токены unrecoverable.
SECRETS_ENCRYPTION_KEY=<<<run python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())' and paste here>>>

# Cookie Secure flag. Должен быть true когда сервис за HTTPS (Caddy/Cloudflare).
# Если еще на HTTP — false (cookie не передастся через https→http).
AUTH_COOKIE_SECURE=true

# --- HTTPS / Caddy (опционально) ---
# Если хотите HTTPS — запускайте docker compose с overlay:
#   docker compose -f docker-compose.yml -f docker-compose.https.yml up -d
#
# Вариант A — с доменом + Let's Encrypt (рекомендуется):
#   DEPLOY_DOMAIN=rnp.example.com
#   DEPLOY_EMAIL=you@example.com
#   DNS: A-запись rnp.example.com → ваш публичный IP, пробросьте 80+443.
#
# Вариант B — без домена, self-signed (для тестов, браузер будет ругаться):
#   DEPLOY_DOMAIN=
#   DEPLOY_EMAIL=
DEPLOY_DOMAIN=
DEPLOY_EMAIL=

# --- Telegram bot (optional) ---
# Get token from @BotFather; without it the `bot` service starts no-op (OK).
# First user to send /start becomes the owner (gets alerts/digest).
# TG_BOT_TOKEN=
